# Server-seitig — niemals an den Browser geben, niemals committen.
# Datei kopieren:  cp .env.example .env.local

OPENAI_API_KEY=sk-...

# Stärkstes Realtime-Sprachmodell laut aktuellem Setup. Alias gpt-realtime bleibt möglich.
OPENAI_REALTIME_MODEL=gpt-realtime-2

# OpenAI empfiehlt low für responsive Voice-Apps.
OPENAI_REASONING_EFFORT=low

# Optional — Jev / TypeSafe Sales Copilot (noch nicht verdrahtet).
# Plan: docs/plans/jev-sales-copilot.md
# Ohne Key: Mock-Fixtures. Niemals VITE_-Prefix, niemals committen.
# TYPESAFE_API_KEY=
# JEV_API_KEY=
